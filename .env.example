# Never commit a populated .env file.
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SAM_API_KEY=replace-with-a-random-api-key
# Dedicated read-only key for the Base44 status gateway. Do not reuse
# SAM_API_KEY; Base44 must not be able to invoke private research endpoints.
SAM_STATUS_API_KEY=replace-with-a-different-random-status-key
DATABASE_URL=postgresql://sam:change-me@postgres:5432/sam
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=replace-with-a-local-password
ALLOWED_ORIGINS=https://sam.vegas,https://www.sam.vegas
QUOTE_MAX_AGE_SECONDS=300
# This is an explicit temporary allow-list for protected research evaluation.
# Production promotion must also be recorded in the model registry.
SAM_APPROVED_MODEL_VERSIONS=
# Future workers are deliberately disabled until raw-payload storage,
# receipt-ledger persistence, provider terms, and a bounded dispatcher are
# reviewed together. A future implementation will require the literal value
# `true`; the current inert worker refuses it and makes no request today.
SAM_INGESTION_ENABLED=false
# The current worker refuses to start unless it is explicitly a private
# ingestion worker and a private object-store prefix has been provisioned.
# Do not add these values to sam-api. A future Render Background Worker gets
# them only after the bucket policy, retention policy, and scoped identity are
# reviewed. The URI is a secret-free prefix, never a signed/public URL.
SAM_WORKER_ROLE=
SAM_RAW_EVIDENCE_STORE_URI=
# The concrete S3-compatible evidence adapter is present but deliberately not
# wired into the inert worker yet. When that later release is reviewed, this
# URI must stay identical to the worker admission URI above, for example:
# s3://sam-evidence-private/raw/odds (no public/signed URL or trailing slash).
# Select exactly one backend: aws_s3 or cloudflare_r2.
SAM_RAW_EVIDENCE_STORE_BACKEND=
# AWS: required region such as us-west-2; leave the endpoint blank to use AWS.
# R2: region must be auto and endpoint must be the account S3 API endpoint.
SAM_RAW_EVIDENCE_S3_REGION=
SAM_RAW_EVIDENCE_S3_ENDPOINT_URL=
# Bounded raw response size; the adapter defaults to 20 MiB and will never
# accept more than 100 MiB. Keep this at 20971520 unless reviewed otherwise.
SAM_RAW_EVIDENCE_MAX_BYTES=20971520
# Future private-worker secrets only. Both AWS S3 and R2 require a dedicated,
# narrowly scoped access-key pair in Render; the adapter intentionally does
# not fall back to a local/developer AWS credential chain. The current inert
# worker rejects these values, and sam-api must never get them. Never place a
# credential in a URI or commit a populated .env file.
SAM_RAW_EVIDENCE_S3_ACCESS_KEY_ID=
SAM_RAW_EVIDENCE_S3_SECRET_ACCESS_KEY=
# Add only after accepting a provider's commercial agreement and keep both
# values exclusively in the future audited worker's secret store, never the
# web API. The current inert worker deliberately refuses either credential.
# Valid current adapter: the_odds_api. Do not put this key in source control.
ODDS_PROVIDER=
ODDS_PROVIDER_API_KEY=
RESULTS_PROVIDER=
RESULTS_PROVIDER_API_KEY=
# Optional Base44 evidence synchronization. Both values live only in the host
# secret store and Base44's secret store; leave blank until the Python service
# is deployed and the Base44 gateway is configured.
BASE44_EVIDENCE_WEBHOOK_URL=
BASE44_EVIDENCE_WEBHOOK_TOKEN=
# Exact hostname parsed from the webhook URL. This pins outbound evidence to
# the expected Base44 function host.
BASE44_EVIDENCE_WEBHOOK_HOST=
