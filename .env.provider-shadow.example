# Copy this file only for the separate recurring provider-ingestion worker.
# Never commit a populated copy or reuse sam-api's/sam-synthetic-worker's group.
APP_ENV=staging

# Paste only Render's Internal Database URL and Internal Key Value URL.
# Both values contain credentials, so this checked-in template leaves them blank.
DATABASE_URL=
REDIS_URL=

# Keep this exact staging-only worker boundary.
SAM_WORKER_ROLE=private_ingestion
SAM_WORKER_MODE=provider_shadow
SAM_INGESTION_ENABLED=true

# Select exactly one admitted sport; this template defaults to MLB. Pregame
# odds use the exact region and market below; completed scores use the sport.
ODDS_PROVIDER=the_odds_api
ODDS_PROVIDER_API_KEY=
SAM_ODDS_SPORT_KEY=baseball_mlb
SAM_ODDS_REGIONS=us
SAM_ODDS_MARKETS=h2h
SAM_PROVIDER_LICENSE_SCOPE=internal_analytics_only
SAM_PROVIDER_LICENSE_VERSION=terms-2026-08-31

# Use a separate R2 Object Read & Write token restricted to the staging bucket.
# Replace ACCOUNT_ID with the account-specific R2 S3 endpoint shown by Cloudflare.
SAM_RAW_EVIDENCE_STORE_BACKEND=cloudflare_r2
SAM_RAW_EVIDENCE_STORE_URI=s3://sam-raw-evidence-staging/raw/the_odds_api
SAM_RAW_EVIDENCE_S3_REGION=auto
SAM_RAW_EVIDENCE_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
SAM_RAW_EVIDENCE_MAX_BYTES=10485760
SAM_RAW_EVIDENCE_S3_ACCESS_KEY_ID=
SAM_RAW_EVIDENCE_S3_SECRET_ACCESS_KEY=

# Public-service credentials, model settings, and ambient AWS/Cloudflare
# credentials are intentionally absent and are rejected.
