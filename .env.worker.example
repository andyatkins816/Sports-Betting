# Copy this file to .env.worker only for the reviewed private staging worker.
# Never commit the populated file or reuse sam-api's environment group.
APP_ENV=staging
# Copy only the Internal URLs from Render. The worker rejects public Render
# database/Key Value hosts; local/Compose aliases are admitted for verification.
DATABASE_URL=
REDIS_URL=

# This release admits exactly one manual, synthetic storage probe. It does not
# authorize provider requests, odds ingestion, results ingestion, or training.
SAM_WORKER_ROLE=private_ingestion
SAM_WORKER_MODE=synthetic_storage_probe
SAM_INGESTION_ENABLED=false

# Keep these exact staging values. Replace ACCOUNT_ID only with the Cloudflare
# R2 account endpoint shown in the dashboard; it is not a public object URL.
SAM_RAW_EVIDENCE_STORE_BACKEND=cloudflare_r2
SAM_RAW_EVIDENCE_STORE_URI=s3://sam-raw-evidence-staging/raw/synthetic
SAM_RAW_EVIDENCE_S3_REGION=auto
SAM_RAW_EVIDENCE_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
SAM_RAW_EVIDENCE_MAX_BYTES=1048576

# Add only a Cloudflare R2 Object Read & Write token restricted to the single
# sam-raw-evidence-staging bucket. R2 bundles object listing with that standard
# permission and its write authority should be assumed to permit copy/delete,
# even though this probe never calls those operations. Choose a time-limited TTL
# if the dashboard offers one, revoke immediately after the probe, and never
# scope it to sam-raw-evidence-prod. Do not use an account-admin token.
SAM_RAW_EVIDENCE_S3_ACCESS_KEY_ID=
SAM_RAW_EVIDENCE_S3_SECRET_ACCESS_KEY=

# Provider, public API, Base44, and ambient AWS/Cloudflare credentials are
# intentionally absent and are rejected if added to this worker.
